# sysctl —— openKylin 3.0 (huanghe) UKUI 系统控制统一封装脚本
#
# 来源：KylinBot 12 个独立技能（/usr/share/kylinbot/.kylinbot/workspace/skills/）
#   audio, bluetooth, keyboard, mouse, navigations, network-manager,
#   osdserver, panel, power, shortcut-navigations, srceen, touchpad
# 每个技能的 SKILL.md 为唯一命令来源；本脚本仅包装其中已记载之方法，不发明新方法。
#
# 技术栈：
#   gdbus call --session --dest org.ukui.Framework   （Devices/UI/Navigations/ShortcutNavigations）
#   nmcli                                              （network-manager）
#   python3 ukui-bluetooth-cli.py                      （bluetooth，DBus 系统服务 com.ukui.bluetooth）
#
# 前置条件：
#   - openKylin UKUI 桌面会话，DBus session bus 可达（unix:path=/run/user/1000/bus）
#   - org.ukui.Framework 服务在运行
#   - gdbus / nmcli / python3 于 PATH 中
#
# 用法：
#   sysctl <域> <子命令> [参数...]
#   sysctl --dry-run <域> <子命令> ...   # 只打印将执行之命令，不实际执行
#   sysctl help                          # 列出全部子命令
#
# 生成日期：2026-08-10
# ============================================================================

# 常量：org.ukui.Framework 各对象路径
OBJ_AUDIO="/org/ukui/Framework/Devices/Audio"
OBJ_SCREEN="/org/ukui/Framework/Devices/Screen"
OBJ_POWER="/org/ukui/Framework/Devices/Power"
OBJ_TOUCHPAD="/org/ukui/Framework/Devices/Touchpad"
OBJ_KEYBOARD="/org/ukui/Framework/Devices/Keyboard"
OBJ_MOUSE="/org/ukui/Framework/Devices/Mouse"
OBJ_PANEL="/org/ukui/Framework/UI/Panel"
OBJ_OSD="/org/ukui/Framework/UI/OsdServer"
OBJ_NAV="/org/ukui/Framework/Navigations"
OBJ_SHORTCUT="/org/ukui/Framework/ShortcutNavigations"
DEST="org.ukui.Framework"

BT_CLI="/usr/share/kylinbot/.kylinbot/workspace/skills/bluetooth/ukui-bluetooth-cli.py"

DRY=0
[ "${1:-}" = "--dry-run" ] && { DRY=1; shift; }

# ---------------------------------------------------------------------------
# 辅助函数
# ---------------------------------------------------------------------------
die() { echo "错误: $*" >&2; exit 1; }

# gdcall <object-path> <interface.method> [args...] —— 经 org.ukui.Framework 的 gdbus 调用
gdcall() {
    local op="$1" im="$2"; shift 2
    local cmd=(gdbus call --session --dest "$DEST" --object-path "$op" --method "$im" "$@")
    if [ "$DRY" = 1 ]; then
        printf '[dry-run] %s\n' "${cmd[*]}"
        return 0
    fi
    "${cmd[@]}"
}

# nm <cmd...> —— nmcli 包装
nm() {
    if [ "$DRY" = 1 ]; then
        printf '[dry-run] nmcli %s\n' "$*"
        return 0
    fi
    nmcli "$@"
}

# bt <cmd...> —— ukui-bluetooth-cli.py 包装
bt() {
    [ -f "$BT_CLI" ] || die "蓝牙 CLI 不存在: $BT_CLI"
    if [ "$DRY" = 1 ]; then
        printf '[dry-run] python3 %s %s\n' "$BT_CLI" "$*"
        return 0
    fi
    python3 "$BT_CLI" "$@"
}

check_int() { # <名> <值> <min> <max>
    local name="$1" val="$2" min="$3" max="$4"
    [[ "$val" =~ ^-?[0-9]+$ ]] || die "$name 须为整数，得到: $val"
    [ "$val" -ge "$min" ] 2>/dev/null && [ "$val" -le "$max" ] 2>/dev/null \
        || die "$name 须在 $min~$max 之间，得到: $val"
}

check_float() { # <名> <值> <min> <max>
    local name="$1" val="$2" min="$3" max="$4"
    awk -v v="$val" -v lo="$min" -v hi="$max" 'BEGIN{exit !(v+0==v && v>=lo && v<=hi)}' \
        || die "$name 须为 $min~$max 之间之数字，得到: $val"
}

check_bool() { # <名> <值>，接受 on/off/true/false/1/0；结果放全局 __BOOL__
    local name="$1" val="$2"
    case "$val" in
        true|on|1)  __BOOL__=true ;;
        false|off|0) __BOOL__=false ;;
        *) die "$name 须为 on/off/true/false，得到: $val" ;;
    esac
}

# 幂等开关：写布尔值
set_bool() { # <object> <interface> <SetterMethod> <on|off>
    local op="$1" iface="$2" meth="$3" sw="$4"
    check_bool "$meth" "$sw"
    gdcall "$op" "$iface.$meth" "$__BOOL__"
}

