# ===========================================================================
# net —— 网络（nmcli）
# ===========================================================================
cmd_net() {
    local sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
        status|devices) nm device status ;;
        connections) nm -t -f NAME,UUID,TYPE,DEVICE connection show ;;
        active) nm -t -f NAME,DEVICE connection show --active ;;
        scan) nm -t -f SSID,SECURITY,SIGNAL device wifi list ;;
        wifi)
            if [ $# -ge 1 ]; then
                case "$1" in on) nm radio wifi on;; off) nm radio wifi off;; *) die "net wifi 须给 on|off";; esac
            else
                nm radio wifi
            fi ;;
        connect) [ $# -ge 1 ] || die "net connect 须给连接名或UUID"; nm connection up "$1" ;;
        connect-wifi)
            [ $# -ge 1 ] || die "net connect-wifi 须给 SSID"
            if [ $# -ge 2 ]; then nm device wifi connect "$1" password "$2"; else nm device wifi connect "$1"; fi ;;
        static-ip)
            [ $# -ge 2 ] || die "net static-ip 须给 <连接> <IP/前缀> [网关] [DNS]"
            local conn="$1" addr="$2" gw="${3:-}" dns="${4:-}"
            if [ "$DRY" = 1 ]; then
                printf '[dry-run] nmcli connection modify "%s" ipv4.method manual ipv4.addresses "%s"\n' "$conn" "$addr"
                [ -n "$gw" ]  && printf '[dry-run] nmcli connection modify "%s" ipv4.gateway "%s"\n' "$conn" "$gw"
                [ -n "$dns" ] && printf '[dry-run] nmcli connection modify "%s" ipv4.dns "%s"\n' "$conn" "$dns"
                printf '[dry-run] nmcli connection up "%s"\n' "$conn"
            else
                nm connection modify "$conn" ipv4.method manual ipv4.addresses "$addr" || return 1
                [ -n "$gw" ]  && { nm connection modify "$conn" ipv4.gateway "$gw" || return 1; }
                [ -n "$dns" ] && { nm connection modify "$conn" ipv4.dns "$dns" || return 1; }
                nm connection up "$conn"
            fi ;;
        dhcp) [ $# -ge 1 ] || die "net dhcp 须给连接名"
              if [ "$DRY" = 1 ]; then
                  printf '[dry-run] nmcli connection modify "%s" ipv4.method auto\n' "$1"
                  printf '[dry-run] nmcli connection up "%s"\n' "$1"
              else
                  nm connection modify "$1" ipv4.method auto || return 1
                  nm connection up "$1"
              fi ;;
        disconnect) [ $# -ge 1 ] || die "net disconnect 须给连接名"; nm connection down "$1" ;;
        ethernet)
            local dev
            dev=$(nm -t -f DEVICE,TYPE device status | awk -F: '$2=="ethernet" {print $1; exit}')
            if [ $# -ge 1 ]; then
                case "$1" in
                    on)  [ -n "$dev" ] || die "未找到有线网卡"
                         nm device set "$dev" managed yes && nm device connect "$dev" ;;
                    off) [ -n "$dev" ] || die "未找到有线网卡"
                         nm device disconnect "$dev" && nm device set "$dev" managed no ;;
                    *) die "net ethernet 须给 on|off";;
                esac
            else
                nm -t -f DEVICE,TYPE device status | awk -F: '$2=="ethernet" {print "有线网卡: "$1}'
            fi ;;
        *) die "net 未知子命令: $sub（用 help 查看）" ;;
    esac
}

# ===========================================================================
# bt —— 蓝牙（ukui-bluetooth-cli.py 包装）
# ===========================================================================
cmd_bt() {
    local sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
        power)            bt power "$@" ;;
        tray)             bt tray "$@" ;;
        discoverable)     bt discoverable "$@" ;;
        active-connection) bt active-connection "$@" ;;
        audio-combine)    bt audio-combine "$@" ;;
        scan)             bt scan "$@" ;;
        list)             bt list ;;
        connect)          [ $# -ge 1 ] || die "bt connect 须给设备地址"; bt connect "$1" ;;
        info)             [ $# -ge 1 ] || die "bt info 须给设备地址"; bt info "$1" ;;
        *) die "bt 未知子命令: $sub（用 help 查看）" ;;
    esac
}

# ===========================================================================
# 主分发
# ===========================================================================
case "$DOMAIN" in
    volume|audio)  cmd_volume "$@" ;;
    screen|srceen) cmd_screen "$@" ;;
    power)         cmd_power "$@" ;;
    touchpad)      cmd_touchpad "$@" ;;
    panel)         cmd_panel "$@" ;;
    kbd|keyboard)  cmd_kbd "$@" ;;
    mouse)         cmd_mouse "$@" ;;
    osd)           cmd_osd "$@" ;;
    nav|navigations) cmd_nav "$@" ;;
    shortcut|shortcut-navigations) cmd_shortcut "$@" ;;
    net|network)   cmd_net "$@" ;;
    bt|bluetooth)  cmd_bt "$@" ;;
    help|-h|--help) usage ;;
    *) die "未知域: $DOMAIN（用 sysctl help 查看）" ;;
esac
exit $?
