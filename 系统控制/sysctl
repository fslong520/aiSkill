# ===========================================================================
# volume —— 音频
# ===========================================================================
cmd_volume() {
    local sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
        get)            gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.getSinkVolume" ;;
        set)            [ $# -ge 1 ] || die "volume set 须给 0-100"; check_int 音量 "$1" 0 100
                        gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.setSinkVolume" "$1" ;;
        mute)           gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.setSinkMute" true ;;
        unmute)         gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.setSinkMute" false ;;
        mute-status)    gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.getSinkMute" ;;
        device)         gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.getSinkDevice" ;;
        device-set)     [ $# -ge 1 ] || die "volume device-set 须给设备名"
                        gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.setSinkDevice" "$@" ;;
        mic-get)        gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.getSourceVolume" ;;
        mic-set)        [ $# -ge 1 ] || die "volume mic-set 须给 0-100"; check_int 麦克风音量 "$1" 0 100
                        gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.setSourceVolume" "$1" ;;
        mic-mute)       gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.setSourceMute" true ;;
        mic-unmute)     gdcall "$OBJ_AUDIO" "org.ukui.Framework.Devices.Audio.setSourceMute" false ;;
        *) die "volume 未知子命令: $sub（用 help 查看）" ;;
    esac
}

# ===========================================================================
# screen —— 屏幕
# ===========================================================================
cmd_screen() {
    local sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
        brightness)
            if [ $# -ge 1 ]; then
                check_int 亮度 "$1" 0 100
                gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.SetPrimaryScreenBrightness" "$1"
            else
                gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.GetAllScreenBrightness"
            fi ;;
        brightness-get)  gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.GetPrimaryScreenBrightness" ;;
        brightness-set)  [ $# -ge 2 ] || die "screen brightness-set 须给 显示器名 和 0-100"
                        check_int 亮度 "$2" 0 100
                        gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.SetScreenBrightness" "$1" "$2" ;;
        brightness-all) [ $# -ge 1 ] || die "screen brightness-all 须给 0-100"; check_int 亮度 "$1" 0 100
                        gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.SetAllScreenSameBrightness" "$1" ;;
        mode)
            if [ $# -ge 1 ]; then
                local m="$1"
                case "$m" in
                    primary)   m=primaryScreenOnlyMode ;;
                    mirror)    m=mirrorScreenMode ;;
                    extension) m=extensionMode ;;
                    secondary) m=secondaryScreenOnlyMode ;;
                esac
                gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.SetScreenMode" "$m"
            else
                gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.GetScreenMode"
            fi ;;
        eyecare)       [ $# -ge 1 ] || die "screen eyecare 须给 on|off"
                       check_bool 护眼 "$1"
                       gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.SetEyeCareEnabled" "$__BOOL__" ;;
        eyecare-status) gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.IsEyeCareEnabled" ;;
        night)         [ $# -ge 1 ] || die "screen night 须给 on|off"
                       check_bool 夜间模式 "$1"
                       gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.SetNightModeEnable" "$__BOOL__" ;;
        scale)         [ $# -ge 1 ] || die "screen scale 须给 1.0-2.0"; check_float 缩放 "$1" 1.0 2.0
                       gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.SetScreenScale" "$1" ;;
        scale-status)  gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.GetScreenScale" ;;
        autobright)    [ $# -ge 1 ] || die "screen autobright 须给 on|off"
                       check_bool 自动亮度 "$1"
                       gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.SetAutoBrightBrightnessEnable" "$__BOOL__" ;;
        increase)      gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.IncreaseBuiltinScreenBrightness" ;;
        decrease)      gdcall "$OBJ_SCREEN" "org.ukui.Framework.Devices.Screen.DecreaseBuiltinBrightness" ;;
        *) die "screen 未知子命令: $sub（用 help 查看）" ;;
    esac
}

# ===========================================================================
# power —— 电源
# ===========================================================================
POWER_STATES=(未知 充电 放电 空 充满 准备充 准备断)
POWER_MODES=(性能 平衡 节能)
POWER_BTN_ACTIONS=(interactive blank suspend hibernate shutdown)
LID_ACTIONS=(nothing blank suspend hibernate shutdown)

cmd_power() {
    local sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
        status)
            local pct state mode
            pct=$(gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.BatteryPercentage")
            state=$(gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetBatteryState")
            mode=$(gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetPowerMode")
            local np ns nm
            np=$(echo "$pct"  | tr -dc '0-9'); ns=$(echo "$state" | tr -dc '0-9'); nm=$(echo "$mode" | tr -dc '0-9')
            [ -n "$np" ] || np=0; [ -n "$ns" ] || ns=0; [ -n "$nm" ] || nm=0
            echo "电量 $np%，状态 ${POWER_STATES[$ns]}，模式 ${POWER_MODES[$nm]}"
            ;;
        battery)       gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.BatteryPercentage" ;;
        state)         gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetBatteryState" ;;
        time-empty)    gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.TimeToEmpty" ;;
        time-full)     gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.TimeToFull" ;;
        mode)
            if [ $# -ge 1 ]; then
                check_int 电源模式 "$1" 0 2
                gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.SetPowerMode" "$1"
            else
                gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetPowerMode"
            fi ;;
        power-button)
            if [ $# -ge 1 ]; then
                local v="$1"; case " ${POWER_BTN_ACTIONS[*]} " in *" $v "*) ;; *) die "电源键动作须为: ${POWER_BTN_ACTIONS[*]}";; esac
                gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.SetPowerButtonAction" "$v"
            else
                gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetPowerButtonAction"
            fi ;;
        lid)
            if [ $# -ge 1 ]; then
                local v="$1"; case " ${LID_ACTIONS[*]} " in *" $v "*) ;; *) die "合盖动作须为: ${LID_ACTIONS[*]}";; esac
                gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.SetLidCloseAction" "$v"
            else
                gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetLidCloseAction"
            fi ;;
        screen-timeout-ac)
            if [ $# -ge 1 ]; then
                check_int AC息屏秒数 "$1" 0 86400
                gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.SetScreenTimeoutOnAC" "$1"
            else
                gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetScreenTimeoutOnAC"
            fi ;;
        screen-timeout-dc) gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetScreenTimeoutOnDC" ;;
        sleep-timeout-ac)  gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetSleepComputerTimeOnAC" ;;
        low-battery)       gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetLowBatteryAction" ;;
        low-battery-threshold) gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetLowBatteryActionThreshold" ;;
        low-battery-notify)    gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetLowBatteryNotifyThreshold" ;;
        show-left-time)  gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.IsShowLeftTime" ;;
        battery-present) gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.IsBatteryPresent" ;;
        lid-present)     gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.IsLid" ;;
        ac-policy)       gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetACPowerPolicy" ;;
        dc-policy)       gdcall "$OBJ_POWER" "org.ukui.Framework.Devices.Power.GetDCPowerPolicy" ;;
        *) die "power 未知子命令: $sub（用 help 查看）" ;;
    esac
}

# ===========================================================================
# touchpad —— 触摸板
# ===========================================================================
cmd_touchpad() {
    local sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
        status)  gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.GetTouchpadEnabled" ;;
        on)      gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.SetTouchpadEnabled" true ;;
        off)     gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.SetTouchpadEnabled" false ;;
        count)   gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.GetTouchpadCount" ;;
        disable-on-mouse) [ $# -ge 1 ] || die "touchpad disable-on-mouse 须给 on|off"
                   check_bool 插入禁用 "$1"
                   gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.SetDisableOnExternalMouse" "$__BOOL__" ;;
        disable-typing) [ $# -ge 1 ] || die "touchpad disable-typing 须给 on|off"
                   check_bool 打字禁用 "$1"
                   gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.SetDisableWhileTyping" "$__BOOL__" ;;
        tap)     [ $# -ge 1 ] || die "touchpad tap 须给 on|off"
                 check_bool 轻触点击 "$1"
                 gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.SetTapToClick" "$__BOOL__" ;;
        natural) [ $# -ge 1 ] || die "touchpad natural 须给 on|off"
                 check_bool 自然滚动 "$1"
                 gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.SetNaturalScroll" "$__BOOL__" ;;
        scroll)  [ $# -ge 1 ] || die "touchpad scroll 须给 0|1|2"; check_int 滚动类型 "$1" 0 2
                 gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.SetScrollType" "$1" ;;
        speed)   [ $# -ge 1 ] || die "touchpad speed 须给数字"; check_float 速度 "$1" 0 10
                 gdcall "$OBJ_TOUCHPAD" "org.ukui.Framework.Devices.Touchpad.SetMotionAcceleration" "$1" ;;
        *) die "touchpad 未知子命令: $sub（用 help 查看）" ;;
    esac
}

# ===========================================================================
